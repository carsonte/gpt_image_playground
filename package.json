{
  "name": "gpt-image-playground",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "server": "node --env-file-if-exists=.env.server.local server/index.mjs",
    "admin:hash": "node --env-file-if-exists=.env.server.local scripts/hash-admin-password.mjs",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "node scripts/server-smoke.mjs",
    "verify:release": "npm test && npm run test:server && npm run build",
    "deploy:server": "node scripts/deploy-server.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "@streamdown/math": "^1.0.2",
    "better-sqlite3": "^13.0.3",
    "core-js": "^3.49.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "dompurify": "^3.4.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.96.0"
  }
}
